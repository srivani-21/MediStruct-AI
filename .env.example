# ==============================================================================
# MediStruct AI - Environment Configuration Example
# Academic Research and Clinical Knowledge Discovery Framework
# ==============================================================================

# ==============================================================================
# AI Provider Selection
# ==============================================================================
# LLM_PROVIDER controls which AI provider is used for clinical structuring
# and handwriting recognition.
#   "ollama"  (default) — local Ollama inference, no external API calls.
#   "gemini"            — Google Gemini 3.8 Flash (requires GEMINI_API_KEY).
#
# NOTE: Changing LLM_PROVIDER while the backend is running is reflected
# dynamically via live .env re-reading in most cases. A backend restart
# (Ctrl+C → uvicorn backend.main:app --reload) provides the strongest guarantee.
LLM_PROVIDER=ollama

# Ollama Local AI Provider
# Install Ollama: https://ollama.com/download
# Start server: ollama serve
# Pull model:   ollama pull qwen3.5:2b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b
# Timeout in seconds for Ollama inference (increase on slow hardware).
# Cold-start (first request) may take 60-120s on CPU-only systems.
OLLAMA_TIMEOUT_SECONDS=180.0
OLLAMA_MAX_RETRIES=2

# Google Gemini API (optional — only needed when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Application & Database Settings
APP_NAME="MediStruct AI"
DEBUG=True
DATABASE_URL=sqlite:///./data/database/medistruct.db
CHROMA_PERSIST_DIRECTORY=./chroma_storage
MAX_UPLOAD_SIZE_MB=50

# OCR & Document Processing Tool Paths (Windows)
# If Tesseract is installed in C:\Program Files\Tesseract-OCR\tesseract.exe:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# If Poppler binary directory is configured:
POPPLER_PATH=

# RAG Settings
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4

# Server CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
